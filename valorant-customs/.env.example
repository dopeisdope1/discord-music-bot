# --- Obligatoire ---
DISCORD_TOKEN=le_token_de_ton_application

# --- Optionnel ---
# ID de l'application (sinon déduit du token automatiquement)
CLIENT_ID=
# Salon où le bot poste ses logs (création, join, leave, avertissement, retrait...)
LOG_CHANNEL_ID=
# Rôle "staff" autorisé à gérer TOUTES les parties (en plus des admins Discord)
STAFF_ROLE_ID=
# Catégorie dans laquelle créer les salons vocaux d'équipe (sinon : catégorie du salon de la partie)
VOICE_CATEGORY_ID=

# Durée de l'avertissement anti-absent, en secondes (défaut : 60)
WARN_SECONDS=60
# Délai laissé au joueur de la liste d'attente pour accepter une place (défaut : 60)
PROMOTE_SECONDS=60
# true = le premier de la liste d'attente prend la place sans confirmation
AUTO_PROMOTE=false
# true = avant la création des salons d'équipe, être dans N'IMPORTE quel vocal suffit
WARN_ACCEPT_ANY_VOICE=true

# Root du bot (accès total + seul à pouvoir donner/retirer l'ownership).
# Facultatif : le propriétaire de l'application Discord est détecté
# automatiquement au démarrage. À renseigner (IDs séparés par des virgules)
# seulement si tu veux plusieurs roots.
BOT_OWNER_IDS=
