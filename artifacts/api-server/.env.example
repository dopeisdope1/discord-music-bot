# Copier ce fichier en ".env" (local) ou renseigner ces variables dans Vexa Node. Ne JAMAIS committer ".env".

# Token du bot Discord "Zinki" (obligatoire)
DISCORD_TOKEN=

# Optionnel — ID de l'application (sert seulement à `npm run deploy`, nettoyage des commandes slash).
CLIENT_ID=

# Optionnel — IDs Discord (séparés par des virgules) ayant un accès propriétaire cross-serveur.
BOT_OWNER_IDS=

# API du panel (discord-bots-panel). Sans PANEL_API_KEY, l'API est désactivée.
# PANEL_API_PORT : le port alloué à cette instance par l'hébergeur (défaut 4000).
PANEL_API_KEY=
PANEL_API_PORT=

# Petit serveur /healthz (hérité de Replit). Défaut 8080. Sur Vexa Node, il n'a pas besoin
# d'être exposé. Ne JAMAIS lui donner le même port que PANEL_API_PORT (EADDRINUSE).
PORT=

# Dossier des données persistantes (JSON, sauvegardes, historique). Défaut : ./data dans artifacts/api-server.
# Sur l'hébergeur, pointer vers un dossier persistant HORS du dossier mis à jour par git.
DATA_DIR=

# Optionnel — chemin d'un binaire ffmpeg système (conversion des emojis vidéo).
# Par défaut : binaire embarqué par le paquet ffmpeg-static.
FFMPEG_PATH=

# Optionnel — "true" pour journaliser les latences d'interaction.
DEBUG_LATENCY=
